/**
 * AERIS Corporate Finance — Google Apps Script backend
 * One master registry + one isolated spreadsheet per organization.
 * Deploy as Web App: Execute as Me; Who has access: Anyone.
 * Run aerisSetup() once from editor. Set FIREBASE_WEB_API_KEY and ALLOWED_ORIGINS in Script Properties.
 * IMPORTANT: Treat as a functional starter, not independently audited accounting software.
 */
const AERIS = Object.freeze({
  channel:'AERIS_RPC_V1',
  master:{Organizations:['id','name','sheetId','ownerUid','createdAt'],Memberships:['id','orgId','uid','email','role','joinedAt'],Invites:['id','orgId','email','role','code','expiresAt','usedAt','createdAt']},
  tables:{
    Accounts:['id','name','type','currency','openingBalance','createdAt','updatedAt'],
    Transactions:['id','date','type','accountId','category','departmentId','contactId','description','amount','referenceId','createdAt','updatedAt'],
    Invoices:['id','number','customerId','issueDate','dueDate','amount','status','notes','createdAt','updatedAt'],
    Bills:['id','number','vendorId','issueDate','dueDate','amount','status','notes','createdAt','updatedAt'],
    Budgets:['id','name','departmentId','category','period','limitAmount','notes','createdAt','updatedAt'],
    Departments:['id','name','manager','notes','createdAt','updatedAt'],
    Contacts:['id','name','kind','email','phone','notes','createdAt','updatedAt'],
    Recurring:['id','name','type','amount','accountId','category','departmentId','nextDate','frequency','active','notes','createdAt','updatedAt'],
    Approvals:['id','title','requester','departmentId','amount','status','notes','createdAt','updatedAt'],
    Payroll:['id','employee','departmentId','period','gross','deductions','status','notes','createdAt','updatedAt'],
    Taxes:['id','name','period','dueDate','amount','status','notes','createdAt','updatedAt'],
    Audit:['id','time','actor','action','table','recordId','requestId','details']
  },
  core:['Accounts','Transactions','Invoices','Bills','Budgets','Departments','Contacts'],
  currencies:['IDR']
});
function aerisErr_(code,msg){const x=new Error(msg);x.code=code;return x;}
function aerisNow_(){return new Date().toISOString();}
function aerisId_(){return Utilities.getUuid();}
function aerisProp_(key){return String(PropertiesService.getScriptProperties().getProperty(key)||'').trim();}
function aerisText_(v,max){return String(v===undefined||v===null?'':v).trim().slice(0,max||300);}
function aerisNum_(v){const n=Number(v);if(!Number.isFinite(n)||n<0||n>1e15)throw aerisErr_('VALIDATION','Nominal tidak valid.');return n;}
function aerisDate_(s){s=String(s||'');if(!/^\d{4}-\d{2}-\d{2}$/.test(s)||new Date(s+'T12:00:00Z').toISOString().slice(0,10)!==s)throw aerisErr_('VALIDATION','Tanggal harus YYYY-MM-DD.');return s;}
function aerisSafe_(value){return /^[=+@\-\t\r]/.test(String(value))?"'"+value:value;}
function aerisInitSheet_(ss,name,header){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.getRange(1,1,1,header.length).setValues([header]);sh.setFrozenRows(1);}else{const old=sh.getRange(1,1,1,header.length).getValues()[0];if(header.some((x,i)=>x!==old[i]))throw aerisErr_('SCHEMA','Struktur sheet '+name+' tidak sesuai. Migrasi diperlukan.');}return sh;}
function aerisRows_(sh,head){const end=sh.getLastRow();if(end<2)return [];return sh.getRange(2,1,end-1,head.length).getValues().map((r,i)=>{const o={_row:i+2};head.forEach((k,j)=>{const v=r[j];o[k]=v instanceof Date?(['date','issueDate','dueDate','nextDate'].includes(k)?Utilities.formatDate(v,Session.getScriptTimeZone()||'Asia/Jakarta','yyyy-MM-dd'):k==='period'?Utilities.formatDate(v,Session.getScriptTimeZone()||'Asia/Jakarta','yyyy-MM'):v.toISOString()):v;});return o;});}
function aerisPublic_(rows){return rows.map(({_row,...r})=>r);}
function aerisWrite_(sh,head,row,idx){const vals=head.map(k=>aerisSafe_(row[k]===undefined?'':row[k]));if(idx){sh.getRange(idx,1,1,vals.length).setValues([vals]);}else sh.appendRow(vals);}
function aerisMaster_(){const id=aerisProp_('MASTER_SHEET_ID');if(!id)throw aerisErr_('NOT_CONFIGURED','Jalankan aerisSetup() terlebih dahulu.');return SpreadsheetApp.openById(id);}
function aerisMasterTab_(name){const m=aerisMaster_();return aerisInitSheet_(m,name,AERIS.master[name]);}
function aerisCompanySheet_(org){return SpreadsheetApp.openById(String(org.sheetId));}
function aerisCompanyTab_(ss,name){if(!AERIS.tables[name])throw aerisErr_('VALIDATION','Tabel tidak dikenal.');return aerisInitSheet_(ss,name,AERIS.tables[name]);}
function aerisLock_(fn){const lock=LockService.getScriptLock();lock.waitLock(25000);try{return fn();}finally{lock.releaseLock();}}
/** First-time setup — RUN ONCE */
function aerisSetup(){let id=aerisProp_('MASTER_SHEET_ID');if(!id){id=SpreadsheetApp.create('AERIS — Master Registry').getId();PropertiesService.getScriptProperties().setProperty('MASTER_SHEET_ID',id);}const ss=SpreadsheetApp.openById(id);Object.keys(AERIS.master).forEach(n=>aerisInitSheet_(ss,n,AERIS.master[n]));Logger.log('Master spreadsheet created: '+ss.getUrl());return ss.getUrl();}
function aerisVerifiedUser_(token,force){token=aerisText_(token,4500);if(!token)throw aerisErr_('AUTH','Silakan login kembali.');const key=aerisProp_('FIREBASE_WEB_API_KEY');if(!key)throw aerisErr_('NOT_CONFIGURED','FIREBASE_WEB_API_KEY belum diisi.');const cache=CacheService.getScriptCache();const ck='aeris:auth:'+Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,token)).slice(0,40);if(!force){const val=cache.get(ck);if(val)return JSON.parse(val);}const url='https://identitytoolkit.googleapis.com/v1/accounts:lookup?key='+encodeURIComponent(key);const res=UrlFetchApp.fetch(url,{method:'post',contentType:'application/json',payload:JSON.stringify({idToken:token}),muteHttpExceptions:true});const o=JSON.parse(res.getContentText()||'{}');const u=(o.users||[])[0];if(res.getResponseCode()!==200||!u||u.disabled||!u.localId)throw aerisErr_('AUTH','Sesi Firebase tidak valid atau telah kedaluwarsa.');if(!u.emailVerified)throw aerisErr_('VERIFY','Verifikasi email sebelum mengakses AERIS.');const who={uid:String(u.localId),email:String(u.email||'').trim().toLowerCase(),name:String(u.displayName||u.email||'')};cache.put(ck,JSON.stringify(who),40);return who;}
function aerisMembership_(user,orgId){const members=aerisRows_(aerisMasterTab_('Memberships'),AERIS.master.Memberships);const member=members.find(m=>m.uid===user.uid&&m.orgId===orgId);if(!member)throw aerisErr_('ACCESS_DENIED','Anda bukan anggota organisasi ini.');const org=aerisRows_(aerisMasterTab_('Organizations'),AERIS.master.Organizations).find(x=>x.id===orgId);if(!org)throw aerisErr_('NOT_FOUND','Perusahaan tidak ditemukan.');return {member,org};}
function aerisRole_(ctx,roles){if(roles.indexOf(String(ctx.member.role))<0)throw aerisErr_('FORBIDDEN','Peran akun tidak memiliki izin untuk tindakan ini.');}
function aerisOrganizations_(user){const orgs=aerisRows_(aerisMasterTab_('Organizations'),AERIS.master.Organizations);const roles=aerisRows_(aerisMasterTab_('Memberships'),AERIS.master.Memberships).filter(r=>r.uid===user.uid);return roles.map(r=>{const o=orgs.find(x=>x.id===r.orgId);return o?{id:o.id,name:o.name,role:r.role,createdAt:o.createdAt}:null;}).filter(Boolean);}
function aerisCreateOrg_(user,p){const name=aerisText_(p.name,90);if(name.length<3)throw aerisErr_('VALIDATION','Nama perusahaan minimal 3 karakter.');return aerisLock_(()=>{const orgs=aerisRows_(aerisMasterTab_('Organizations'),AERIS.master.Organizations);if(orgs.filter(o=>o.ownerUid===user.uid).length>=10)throw aerisErr_('LIMIT','Maksimal 10 organisasi dimiliki satu akun.');const sheet=SpreadsheetApp.create('AERIS — '+name);try{Object.keys(AERIS.tables).forEach(t=>aerisCompanyTab_(sheet,t));const id=aerisId_(),time=aerisNow_();aerisWrite_(aerisMasterTab_('Organizations'),AERIS.master.Organizations,{id,name,sheetId:sheet.getId(),ownerUid:user.uid,createdAt:time});aerisWrite_(aerisMasterTab_('Memberships'),AERIS.master.Memberships,{id:aerisId_(),orgId:id,uid:user.uid,email:user.email,role:'owner',joinedAt:time});return {id,name,role:'owner'};}catch(e){throw e;}});}
function aerisCreateInvite_(ctx,p){aerisRole_(ctx,['owner']);const email=aerisText_(p.email,200).toLowerCase(),role=aerisText_(p.role,12);if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))throw aerisErr_('VALIDATION','Email undangan tidak valid.');if(!['editor','viewer'].includes(role))throw aerisErr_('VALIDATION','Peran undangan tidak valid.');const code=Utilities.getUuid().replace(/-/g,'').slice(0,12).toUpperCase();const exp=new Date(Date.now()+7*86400000).toISOString();return aerisLock_(()=>{aerisWrite_(aerisMasterTab_('Invites'),AERIS.master.Invites,{id:aerisId_(),orgId:ctx.org.id,email,role,code,expiresAt:exp,usedAt:'',createdAt:aerisNow_()});return {code,email,role,expiresAt:exp};});}
function aerisJoinOrg_(user,p){const code=aerisText_(p.code,32).toUpperCase();if(!code)throw aerisErr_('VALIDATION','Masukkan kode undangan.');return aerisLock_(()=>{const sh=aerisMasterTab_('Invites');const invite=aerisRows_(sh,AERIS.master.Invites).find(i=>i.code===code);if(!invite||invite.usedAt||String(invite.expiresAt)<=aerisNow_()||String(invite.email).toLowerCase()!==user.email)throw aerisErr_('ACCESS_DENIED','Undangan tidak valid, kedaluwarsa, atau bukan untuk email Anda.');const members=aerisRows_(aerisMasterTab_('Memberships'),AERIS.master.Memberships);if(members.some(m=>m.orgId===invite.orgId&&m.uid===user.uid))throw aerisErr_('CONFLICT','Anda sudah menjadi anggota perusahaan ini.');aerisWrite_(aerisMasterTab_('Memberships'),AERIS.master.Memberships,{id:aerisId_(),orgId:invite.orgId,uid:user.uid,email:user.email,role:invite.role,joinedAt:aerisNow_()});invite.usedAt=aerisNow_();aerisWrite_(sh,AERIS.master.Invites,invite,invite._row);return {joined:true,orgId:invite.orgId};});}
function aerisTeam_(ctx){const members=aerisRows_(aerisMasterTab_('Memberships'),AERIS.master.Memberships).filter(m=>m.orgId===ctx.org.id);return aerisPublic_(members).map(x=>({id:x.id,email:x.email,role:x.role,joinedAt:x.joinedAt}));}
function aerisChangeRole_(ctx,p){aerisRole_(ctx,['owner']);const uid=aerisText_(p.id,100),role=aerisText_(p.role,20);if(!['editor','viewer','remove'].includes(role))throw aerisErr_('VALIDATION','Role tidak valid.');return aerisLock_(()=>{const sh=aerisMasterTab_('Memberships');const member=aerisRows_(sh,AERIS.master.Memberships).find(x=>x.id===uid&&x.orgId===ctx.org.id);if(!member||member.role==='owner')throw aerisErr_('FORBIDDEN','Pemilik perusahaan tidak dapat diubah atau dihapus.');if(role==='remove')sh.deleteRow(member._row);else{member.role=role;aerisWrite_(sh,AERIS.master.Memberships,member,member._row);}return {ok:true};});}
function aerisSnapshot_(ctx){const ss=aerisCompanySheet_(ctx.org),data={};AERIS.core.forEach(n=>data[n]=aerisPublic_(aerisRows_(aerisCompanyTab_(ss,n),AERIS.tables[n])));return {organization:{id:ctx.org.id,name:ctx.org.name,role:ctx.member.role},user:{name:ctx.user.name,email:ctx.user.email},data,loadedTables:AERIS.core,serverTime:aerisNow_()};}
function aerisLoad_(ctx,p){const name=aerisText_(p.table,40);if(!AERIS.tables[name]||name==='Audit')throw aerisErr_('VALIDATION','Modul tidak tersedia.');const sh=aerisCompanyTab_(aerisCompanySheet_(ctx.org),name);return {table:name,rows:aerisPublic_(aerisRows_(sh,AERIS.tables[name]))};}
function aerisAudit_(ss,user,action,table,recordId,requestId,details){const sh=aerisCompanyTab_(ss,'Audit');aerisWrite_(sh,AERIS.tables.Audit,{id:aerisId_(),time:aerisNow_(),actor:user.email,action,table,recordId,requestId,details:aerisText_(details,500)});}
function aerisReqDuplicate_(ss,requestId){if(!requestId)return false;const sh=aerisCompanyTab_(ss,'Audit');if(sh.getLastRow()<2)return false;return !!sh.getRange(2,7,sh.getLastRow()-1,1).createTextFinder(requestId).matchEntireCell(true).findNext();}
function aerisValidate_(ss,table,rec){const head=AERIS.tables[table];if(!head||table==='Audit')throw aerisErr_('FORBIDDEN','Tabel tidak dapat diedit.');const r={};head.filter(k=>k!=='id'&&k!=='createdAt'&&k!=='updatedAt').forEach(k=>{r[k]=aerisText_(rec[k],k==='notes'?1500:350);});const amountFields={Accounts:['openingBalance'],Transactions:['amount'],Invoices:['amount'],Bills:['amount'],Budgets:['limitAmount'],Recurring:['amount'],Approvals:['amount'],Payroll:['gross','deductions'],Taxes:['amount']};(amountFields[table]||[]).forEach(k=>r[k]=aerisNum_(r[k]||0));for(const k of ['date','issueDate','dueDate','nextDate'])if(head.indexOf(k)>=0)r[k]=aerisDate_(r[k]);if(table==='Transactions'){r.referenceId='';if(!['income','expense'].includes(r.type)||r.amount<=0)throw aerisErr_('VALIDATION','Transaksi harus memiliki jenis dan nominal positif.');const accounts=aerisRows_(aerisCompanyTab_(ss,'Accounts'),AERIS.tables.Accounts);if(!accounts.some(x=>x.id===r.accountId))throw aerisErr_('VALIDATION','Rekening tidak ditemukan.');}
if(table==='Accounts'&&!r.name)throw aerisErr_('VALIDATION','Nama rekening wajib diisi.');if(table==='Accounts'&&r.currency!=='IDR')throw aerisErr_('VALIDATION','Versi awal hanya mendukung laporan dalam IDR.');
if(table==='Contacts'&&!r.name)throw aerisErr_('VALIDATION','Nama relasi wajib diisi.');
if(table==='Departments'&&!r.name)throw aerisErr_('VALIDATION','Nama departemen wajib diisi.');
if(table==='Invoices'||table==='Bills'){if(r.amount<=0||!r.number)throw aerisErr_('VALIDATION','Nomor dokumen dan nominal wajib diisi.');if(!['draft','open','overdue','cancelled','paid'].includes(r.status))throw aerisErr_('VALIDATION','Status dokumen tidak valid.');}
if(table==='Recurring'){if(!['income','expense'].includes(r.type)||r.amount<=0||!['daily','weekly','monthly','yearly'].includes(r.frequency))throw aerisErr_('VALIDATION','Aturan recurring tidak valid.');if(!aerisRows_(aerisCompanyTab_(ss,'Accounts'),AERIS.tables.Accounts).some(a=>a.id===r.accountId))throw aerisErr_('VALIDATION','Rekening recurring tidak ditemukan.');r.active=String(r.active)==='true'?'true':'false';}
return r;}
function aerisUpsert_(ctx,p){aerisRole_(ctx,['owner','editor']);const table=aerisText_(p.table,40),id=aerisText_(p.record&&p.record.id,100),requestId=aerisText_(p.requestId,120);const ss=aerisCompanySheet_(ctx.org);return aerisLock_(()=>{if(aerisReqDuplicate_(ss,requestId))return {duplicate:true,id};const sh=aerisCompanyTab_(ss,table);const prev=id?aerisRows_(sh,AERIS.tables[table]).find(x=>x.id===id):null;if(id&&!prev)throw aerisErr_('NOT_FOUND','Record tidak ditemukan.');if(prev&&table==='Transactions'&&prev.referenceId)throw aerisErr_('FORBIDDEN','Transaksi pembayaran tertaut tidak dapat diubah.');const data=aerisValidate_(ss,table,p.record||{});if(prev&&(table==='Invoices'||table==='Bills')&&prev.status==='paid')throw aerisErr_('FORBIDDEN','Dokumen lunas tidak dapat diedit.');if(!prev&&(table==='Invoices'||table==='Bills')&&data.status==='paid')throw aerisErr_('VALIDATION','Gunakan Catat Pembayaran untuk menandai lunas.');if(prev&&(table==='Invoices'||table==='Bills')&&data.status==='paid')throw aerisErr_('VALIDATION','Gunakan Catat Pembayaran untuk menandai lunas.');const now=aerisNow_(),newId=prev?prev.id:aerisId_(),row={...data,id:newId,createdAt:prev?prev.createdAt:now,updatedAt:now};aerisWrite_(sh,AERIS.tables[table],row,prev&&prev._row);aerisAudit_(ss,ctx.user,prev?'update':'create',table,newId,requestId,row.name||row.number||row.description||'');return {id:newId};});}
function aerisDelete_(ctx,p){const table=aerisText_(p.table,40),id=aerisText_(p.id,100),requestId=aerisText_(p.requestId,120);if(!AERIS.tables[table]||table==='Audit')throw aerisErr_('VALIDATION','Tabel tidak valid.');aerisRole_(ctx,['owner']);const ss=aerisCompanySheet_(ctx.org);return aerisLock_(()=>{if(aerisReqDuplicate_(ss,requestId))return {duplicate:true};const sh=aerisCompanyTab_(ss,table),row=aerisRows_(sh,AERIS.tables[table]).find(x=>x.id===id);if(!row)throw aerisErr_('NOT_FOUND','Data tidak ditemukan.');if(table==='Transactions'&&row.referenceId)throw aerisErr_('FORBIDDEN','Transaksi tertaut tidak bisa dihapus.');if(['Invoices','Bills'].includes(table)&&row.status==='paid')throw aerisErr_('FORBIDDEN','Dokumen lunas tidak bisa dihapus.');if(table==='Accounts'&&aerisRows_(aerisCompanyTab_(ss,'Transactions'),AERIS.tables.Transactions).some(t=>t.accountId===id))throw aerisErr_('FORBIDDEN','Rekening yang memiliki transaksi tidak dapat dihapus.');sh.deleteRow(row._row);aerisAudit_(ss,ctx.user,'delete',table,id,requestId,'Removed by owner');return {deleted:true};});}
function aerisPayment_(ctx,p){aerisRole_(ctx,['owner','editor']);const table=aerisText_(p.table,30);if(!['Invoices','Bills'].includes(table))throw aerisErr_('VALIDATION','Jenis dokumen salah.');const id=aerisText_(p.id,100),accountId=aerisText_(p.accountId,100),date=aerisDate_(p.date),requestId=aerisText_(p.requestId,120),ss=aerisCompanySheet_(ctx.org);return aerisLock_(()=>{if(aerisReqDuplicate_(ss,requestId))return {duplicate:true};const sh=aerisCompanyTab_(ss,table),doc=aerisRows_(sh,AERIS.tables[table]).find(x=>x.id===id);if(!doc||doc.status==='cancelled')throw aerisErr_('NOT_FOUND','Dokumen tidak tersedia untuk pembayaran.');const txSh=aerisCompanyTab_(ss,'Transactions'),txs=aerisRows_(txSh,AERIS.tables.Transactions),ref=table+':'+id;if(txs.some(x=>x.referenceId===ref))throw aerisErr_('CONFLICT','Pembayaran dokumen sudah dicatat.');if(!aerisRows_(aerisCompanyTab_(ss,'Accounts'),AERIS.tables.Accounts).some(a=>a.id===accountId))throw aerisErr_('VALIDATION','Rekening tidak ditemukan.');const now=aerisNow_(),tid=aerisId_();aerisWrite_(txSh,AERIS.tables.Transactions,{id:tid,date,type:table==='Invoices'?'income':'expense',accountId,category:table==='Invoices'?'Invoice collection':'Vendor bill',departmentId:'',contactId:table==='Invoices'?doc.customerId:doc.vendorId,description:(table==='Invoices'?'Payment received ':'Bill paid ')+doc.number,amount:aerisNum_(doc.amount),referenceId:ref,createdAt:now,updatedAt:now});doc.status='paid';doc.updatedAt=now;aerisWrite_(sh,AERIS.tables[table],doc,doc._row);aerisAudit_(ss,ctx.user,'payment',table,id,requestId,'Transaction '+tid);return {paid:true,transactionId:tid};});}
function aerisAuditRead_(ctx){aerisRole_(ctx,['owner','editor']);const ss=aerisCompanySheet_(ctx.org);return {rows:aerisPublic_(aerisRows_(aerisCompanyTab_(ss,'Audit'),AERIS.tables.Audit).slice(-150).reverse())};}
function aerisRoute_(req){const action=aerisText_(req.action,50),payload=req.payload||{};const mutating=['createOrganization','joinOrganization','invite','setRole','upsert','remove','recordPayment'].includes(action);const user=aerisVerifiedUser_(req.token,mutating);if(action==='listOrganizations')return {organizations:aerisOrganizations_(user),user:{email:user.email,name:user.name}};if(action==='createOrganization')return aerisCreateOrg_(user,payload);if(action==='joinOrganization')return aerisJoinOrg_(user,payload);const ctx=aerisMembership_(user,aerisText_(req.orgId,100));ctx.user=user;if(action==='snapshot')return aerisSnapshot_(ctx);if(action==='loadModule')return aerisLoad_(ctx,payload);if(action==='team')return {members:aerisTeam_(ctx)};if(action==='invite')return aerisCreateInvite_(ctx,payload);if(action==='setRole')return aerisChangeRole_(ctx,payload);if(action==='upsert')return aerisUpsert_(ctx,payload);if(action==='remove')return aerisDelete_(ctx,payload);if(action==='recordPayment')return aerisPayment_(ctx,payload);if(action==='audit')return aerisAuditRead_(ctx);throw aerisErr_('UNKNOWN_ACTION','Action tidak ditemukan.');}
function doGet(){return ContentService.createTextOutput('AERIS Finance API is running.');}
function doPost(e){let origin='',rid='',result;try{const params=e&&e.parameter||{};origin=aerisText_(params.replyOrigin,250);rid=aerisText_(params.requestId,120);const allowed=aerisProp_('ALLOWED_ORIGINS').split(',').map(x=>x.trim()).filter(Boolean);if(!allowed.includes(origin))return HtmlService.createHtmlOutput('Origin not allowed.').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);const req=JSON.parse(String(params.request||'{}'));result={ok:true,data:aerisRoute_(req)};}catch(err){result={ok:false,error:{code:err.code||'SERVER_ERROR',message:String(err.message||'Server error').slice(0,500)}};}if(!origin||!aerisProp_('ALLOWED_ORIGINS').split(',').map(x=>x.trim()).includes(origin))return HtmlService.createHtmlOutput('Origin not allowed.').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);const serialized=JSON.stringify({channel:AERIS.channel,requestId:rid,result}).replace(/</g,'\\u003c').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');const target=JSON.stringify(origin).replace(/</g,'\\u003c');return HtmlService.createHtmlOutput('<!doctype html><html><body><script>window.top.postMessage('+serialized+','+target+');<\/script></body></html>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}

/* Optional: one time install after aerisSetup. Scheduled rules process all companies. */
function aerisInstallDailyTrigger(){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='aerisRecurringSweep').forEach(ScriptApp.deleteTrigger);ScriptApp.newTrigger('aerisRecurringSweep').timeBased().everyDays(1).atHour(6).create();Logger.log('AERIS daily recurring trigger installed.');}
function aerisNextDate_(date,frequency){const d=new Date(aerisDate_(date)+'T12:00:00Z');const day=d.getUTCDate();if(frequency==='daily')d.setUTCDate(day+1);else if(frequency==='weekly')d.setUTCDate(day+7);else if(frequency==='monthly'){d.setUTCDate(1);d.setUTCMonth(d.getUTCMonth()+1);const last=new Date(Date.UTC(d.getUTCFullYear(),d.getUTCMonth()+1,0)).getUTCDate();d.setUTCDate(Math.min(day,last));}else if(frequency==='yearly'){d.setUTCDate(1);d.setUTCFullYear(d.getUTCFullYear()+1);const last=new Date(Date.UTC(d.getUTCFullYear(),d.getUTCMonth()+1,0)).getUTCDate();d.setUTCDate(Math.min(day,last));}return d.toISOString().slice(0,10);}
function aerisRecurringSweep(){const today=Utilities.formatDate(new Date(),Session.getScriptTimeZone()||'Asia/Jakarta','yyyy-MM-dd');const orgs=aerisRows_(aerisMasterTab_('Organizations'),AERIS.master.Organizations);orgs.forEach(org=>{try{aerisLock_(()=>{const ss=aerisCompanySheet_(org),rs=aerisCompanyTab_(ss,'Recurring'),tx=aerisCompanyTab_(ss,'Transactions'),rules=aerisRows_(rs,AERIS.tables.Recurring);let allTx=aerisRows_(tx,AERIS.tables.Transactions);rules.filter(r=>String(r.active)==='true').forEach(r=>{let due=String(r.nextDate),count=0,changed=false;while(due&&due<=today&&count<12){const ref='Recurring:'+r.id+':'+due;if(!allTx.some(t=>t.referenceId===ref)){const now=aerisNow_(),row={id:aerisId_(),date:due,type:r.type,accountId:r.accountId,category:r.category,departmentId:r.departmentId,contactId:'',description:r.name,amount:aerisNum_(r.amount),referenceId:ref,createdAt:now,updatedAt:now};aerisWrite_(tx,AERIS.tables.Transactions,row);allTx.push(row);aerisAudit_(ss,{email:'system@aeris'},'recurring','Transactions',row.id,'',ref);}due=aerisNextDate_(due,r.frequency);count++;changed=true;}if(changed){r.nextDate=due;r.updatedAt=aerisNow_();aerisWrite_(rs,AERIS.tables.Recurring,r,r._row);}});});}catch(err){console.error('Recurring org '+org.id+': '+err.message);}});}
